EXCHANGERATE_API_KEY=

# --- DGFT eBRC API credentials (from Services > eBRC > API Credential on dgft.gov.in) ---
DGFT_IEC_CODE=AXGPK0287Q
DGFT_CLIENT_ID=AXGPK0287Q_2014126
DGFT_CLIENT_SECRET=fKrTBndGu9WVkfnyCTj9LUnZwIViZk9Y
DGFT_X_API_KEY=R65sfehouz5WXVDlx6MlW93geKpUS8I5x7GGgIZ7
# userprivateKey from credentials*.txt (PKCS8 DER base64)
DGFT_PRIVATE_
# dgftpublicKey from credentials*.txt (X509 DER base64) — needed for secretVal encryption
# Re-generate credentials on DGFT portal if this field is missing from your credential file
DGFT_PUBLIC_

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8001/api/v1
DGCIS_MODE=backfill
TRADESTAT_MODE=scrape
TRADESTAT_TIMEOUT=60
OEC_ENABLED=false
