# =================================================================
# India Trade Analytics — Environment Template
# Copy this to `.env` and adjust values. The .env file is gitignored.
# =================================================================

# --- Database ---
POSTGRES_USER=trade
POSTGRES_PASSWORD=changeme
POSTGRES_DB=india_trade
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Backend / Auth ---
# IMPORTANT: replace JWT_SECRET with a long random string in production.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_SECRET_PREVIOUS=
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=7

# Default admin user (created on first start if not present).
# Change ADMIN_PASSWORD before going to production.
ADMIN_EMAIL=admin@india-trade.com
ADMIN_PASSWORD=admin123

FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
ENABLE_SCHEDULER=true

# --- Ingestion API keys (all optional; the app falls back to public
#     endpoints where available) ---
# UN Comtrade key — sign up free at https://comtradedeveloper.un.org/
COMTRADE_API_KEY=
# ExchangeRate-API key — free tier at https://www.exchangerate-api.com/
EXCHANGERATE_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
